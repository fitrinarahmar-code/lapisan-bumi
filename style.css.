@import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&display=swap');

:root {
  --green-dark: #24623e;
  --green: #4ca96b;
  --green-light: #e7f8e9;
  --blue: #4caddb;
  --cream: #fff9e9;
  --text: #315443;
  --white: #ffffff;
  --shadow: 0 10px 28px rgba(50,110,72,.12);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
}

body {
  font-family: 'Nunito', sans-serif;
  color: var(--text);
  background: #f7fff7;
  overflow-x: hidden;
}

button, a {
  font-family: inherit;
}

a {
  text-decoration: none;
  color: inherit;
}

button {
  cursor: pointer;
}

/* ==========================
   NAVBAR
========================== */

.navbar {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 13px 5%;
  background: rgba(255,255,255,.96);
  box-shadow: 0 4px 18px rgba(35,90,54,.08);
}

.logo {
  display: flex;
  align-items: center;
  gap: 9px;
  font-size: 23px;
  font-weight: 900;
  color: var(--green-dark);
}

.logo-globe {
  font-size: 31px;
}

.logo-green {
  color: #4ca96b;
}

nav {
  display: flex;
  align-items: center;
  gap: 5px;
}

nav a {
  padding: 10px 12px;
  border-radius: 15px;
  font-size: 13px;
  font-weight: 900;
  transition: .25s;
}

nav a:hover {
  background: #e5f7e8;
  color: #32854e;
  transform: translateY(-2px);
}

.menu-toggle {
  display: none;
  border: 0;
  background: #e7f8e9;
  color: #286b43;
  border-radius: 12px;
  padding: 9px 13px;
  font-size: 22px;
}

/* ==========================
   HERO BERANDA
========================== */

.hero {
  position: relative;
  display: grid;
  grid-template-columns: 1.05fr .95fr;
  align-items: center;
  gap: 20px;
  min-height: 620px;
  padding: 65px 7%;
  overflow: hidden;
  background:
    radial-gradient(circle at 80% 20%,#c9f3d0,transparent 30%),
    linear-gradient(135deg,#e7f8e9,#f4fff4,#dff4e8);
}

.hero::after {
  content: "";
  position: absolute;
  width: 120%;
  height: 100px;
  bottom: -65px;
  left: -10%;
  border-radius: 50%;
  background: #b4df9d;
}

.hero-text {
  position: relative;
  z-index: 3;
}

.welcome-label {
  display: inline-block;
  background: white;
  color: #37834f;
  border-radius: 30px;
  padding: 10px 16px;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 1px;
  box-shadow: var(--shadow);
}

.hero h1 {
  color: #285e3b;
  font-size: clamp(40px,5vw,64px);
  font-weight: 900;
  line-height: 1.15;
  margin: 22px 0;
}

.hero h1 span {
  display: block;
  color: #4aa967;
  text-shadow: 2px 3px 0 #d0efcf;
}

.hero-text p {
  color: #607c68;
  line-height: 1.9;
  max-width: 540px;
  font-size: 15px;
}

.hero-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 13px;
  margin: 26px 0;
}

.btn {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  gap: 7px;
  border: 0;
  padding: 13px 21px;
  border-radius: 16px;
  font-size: 14px;
  font-weight: 900;
  transition: .25s;
}

.btn:hover {
  transform: translateY(-4px);
  box-shadow: 0 9px 20px rgba(50,110,72,.18);
}

.primary {
  background: linear-gradient(120deg,#51bd73,#328c53);
  color: white;
  box-shadow: 0 6px 15px #3c995b30;
}

.secondary {
  background: white;
  color: #398c54;
  border: 1px solid #cfe9d2;
}

.hero-statistics {
  display: flex;
  flex-wrap: wrap;
  gap: 13px;
  margin-top: 30px;
}

.hero-statistics div {
  display: grid;
  gap: 3px;
  padding: 12px 15px;
  border-radius: 15px;
  background: rgba(255,255,255,.85);
  box-shadow: 0 5px 15px #286b4310;
}

.hero-statistics strong {
  font-size: 17px;
  color: #34894f;
}

.hero-statistics span {
  font-size: 11px;
  color: #78917d;
  font-weight: 800;
}

/* Dekorasi awan dan bintang */

.cloud {
  position: absolute;
  font-size: 65px;
  opacity: .65;
  animation: cloudMove 7s ease-in-out infinite;
}

.cloud-one {
  top: 5%;
  left: 43%;
}

.cloud-two {
  bottom: 12%;
  left: 3%;
  font-size: 48px;
}

.hero-star {
  position: absolute;
  color: #f3c64e;
  font-size: 35px;
}

.star-one {
  top: 12%;
  right: 10%;
}

.star-two {
  top: 45%;
  left: 48%;
}

/* Ilustrasi Bumi */

.hero-visual {
  position: relative;
  z-index: 2;
  min-height: 430px;
  display: grid;
  place-items: center;
}

.sun {
  position: absolute;
  top: 3%;
  right: 10%;
  font-size: 55px;
  animation: sunRotate 15s linear infinite;
}

.earth-decoration {
  position: absolute;
  top: 5%;
  left: 2%;
  font-size: 85px;
  animation: float 4s ease-in-out infinite;
}

.earth-globe {
  filter: drop-shadow(0 8px 10px #267c4640);
}

.earth-face {
  position: absolute;
  right: 0;
  bottom: 0;
  font-size: 24px;
}

.earth-cutaway {
  position: relative;
  width: 245px;
  height: 245px;
  border-radius: 50%;
  background: #53a966;
  box-shadow: 0 15px 35px #246b3c30;
  display: grid;
  place-items: center;
  animation: float 5s ease-in-out infinite;
  overflow: hidden;
}

.cutaway-title {
  position: absolute;
  top: 13px;
  color: white;
  font-size: 13px;
  font-weight: 900;
  z-index: 3;
}

.cutaway-earth {
  width: 195px;
  height: 195px;
  border-radius: 50%;
  background: #e98a43;
  display: grid;
  place-items: center;
  border: 7px solid #75bd6e;
}

.cut-crust {
  width: 160px;
  height: 160px;
  background: #f3ad47;
  border: 5px solid #b96d35;
  border-radius: 50%;
  display: grid;
  place-items: center;
}

.cut-mantle {
  width: 118px;
  height: 118px;
  background: #f4b84e;
  border: 5px solid #e98539;
  border-radius: 50%;
  display: grid;
  place-items: center;
}

.cut-outer {
  width: 76px;
  height: 76px;
  background: #ffdf64;
  border: 5px solid #e8a73d;
  border-radius: 50%;
  display: grid;
  place-items: center;
}

.cut-inner {
  width: 37px;
  height: 37px;
  background: #fff2a5;
  border-radius: 50%;
  box-shadow: 0 0 15px #fff2a5;
}

.earth-label {
  position: absolute;
  z-index: 4;
  background: white;
  border: 2px solid #d4efd4;
  color: #3b7048;
  padding: 9px 13px;
  border-radius: 14px;
  font-size: 12px;
  font-weight: 900;
  box-shadow: var(--shadow);
}

.label-one {
  top: 14%;
  right: 1%;
}

.label-two {
  top: 38%;
  right: -2%;
}

.label-three {
  bottom: 24%;
  left: 0;
}

.label-four {
  bottom: 7%;
  right: 9%;
}

.mascot {
  position: absolute;
  bottom: 0;
  left: 2%;
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 45px;
}

.mascot span {
  font-size: 12px;
  background: white;
  padding: 10px;
  border-radius: 15px;
  font-weight: 900;
  color: #348b50;
  box-shadow: var(--shadow);
}

/* ==========================
   JUDUL SECTION
========================== */

.section-heading {
  text-align: center;
  margin-bottom: 38px;
}

.section-heading > span {
  color: #4ca96b;
  font-size: 12px;
  font-weight: 900;
  letter-spacing: 2px;
}

.section-heading h2 {
  font-size: clamp(26px,4vw,37px);
  color: #285e3b;
  margin: 10px 0;
  font-weight: 900;
}

.section-heading p {
  color: #78917d;
  line-height: 1.7;
  font-size: 14px;
}

/* ==========================
   KARTU FITUR
========================== */

.features-section {
  position: relative;
  padding: 75px 6%;
  background: #f9fff8;
}

.features {
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 18px;
}

.feature-card {
  padding: 25px 21px;
  border-radius: 24px;
  border: 2px solid white;
  box-shadow: var(--shadow);
  transition: .3s;
}

.feature-card:hover {
  transform: translateY(-9px);
}

.card-blue {
  background: #e5f5ff;
}

.card-pink {
  background: #fff0f5;
}

.card-green {
  background: #e5f7e7;
}

.card-yellow {
  background: #fff7dc;
}

.feature-picture {
  font-size: 43px;
  margin-bottom: 15px;
}

.feature-card h3 {
  color: #315d43;
  margin-bottom: 10px;
  font-size: 17px;
}

.feature-card p {
  color: #748b7a;
  font-size: 13px;
  line-height: 1.8;
  min-height: 70px;
  margin-bottom: 14px;
}

.feature-card b {
  color: #348c52;
  font-size: 13px;
}

/* ==========================
   SECTION UMUM
========================== */

.section {
  padding: 75px 7%;
}

/* ==========================
   MATERI
========================== */

.material-section {
  background: linear-gradient(140deg,#edfaed,#f8fff8);
}

.material-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 35px;
}

.material-art {
  min-height: 370px;
  position: relative;
  display: grid;
  place-items: center;
  background: #dff2dd;
  border-radius: 30px;
  overflow: hidden;
}

.earth-big {
  position: absolute;
  top: 12px;
  left: 12px;
  font-size: 80px;
}

.earth-section-art {
  width: 245px;
  height: 245px;
  border-radius: 50%;
  background: #52a868;
  display: grid;
  place-items: center;
  box-shadow: 0 12px 25px #246b3c30;
}

.earth-section-inner {
  width: 185px;
  height: 185px;
  border-radius: 50%;
  background: #ed9145;
  display: grid;
  place-items: center;
  border: 7px solid #75bd6e;
}

.earth-section-inner::before {
  content: "";
  position: absolute;
  width: 110px;
  height: 110px;
  background: #f4c451;
  border-radius: 50%;
}

.earth-section-core {
  z-index: 2;
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: #fff0a0;
  box-shadow: 0 0 15px #fff0a0;
}

.art-caption {
  position: absolute;
  bottom: 18px;
  background: white;
  padding: 11px 18px;
  border-radius: 15px;
  font-weight: 900;
  font-size: 13px;
}

.material-list {
  display: grid;
  gap: 12px;
}

.material-button {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  gap: 10px;
  width: 100%;
  background: white;
  border: 2px solid #e2efe3;
  border-radius: 15px;
  padding: 15px;
  color: #356346;
  font-weight: 900;
  text-align: left;
  transition: .2s;
}

.material-button:hover,
.material-button.active {
  background: #e4f6e7;
  border-color: #71c083;
  transform: translateX(4px);
}

.material-button .arrow {
  margin-left: auto;
  font-size: 22px;
  color: #4ba86a;
}

.material-detail {
  background: white;
  border-radius: 18px;
  padding: 22px;
  line-height: 1.8;
  border-left: 5px solid #55ae70;
  box-shadow: var(--shadow);
  font-size: 13px;
}

.material-detail h3 {
  color: #348c52;
  margin-bottom: 8px;
  font-size: 19px;
}

/* ==========================
   EKSPLORASI
========================== */

.exploration-section {
  background: #f8fff8;
}

.exploration-card {
  display: grid;
  grid-template-columns: .9fr 1.1fr;
  align-items: center;
  gap: 30px;
  background: linear-gradient(120deg,#e6f7e7,#e7f7ff);
  padding: 35px;
  border-radius: 28px;
  box-shadow: var(--shadow);
}

.exploration-illustration {
  min-height: 300px;
  position: relative;
  display: grid;
  place-items: center;
}

.planet-circle {
  font-size: 150px;
  z-index: 2;
  animation: float 4s ease-in-out infinite;
  filter: drop-shadow(0 10px 10px #246b3c30);
}

.orbit-decoration {
  position: absolute;
  width: 90%;
  height: 60%;
  border: 3px dashed #8ccf9b;
  border-radius: 50%;
  transform: rotate(-25deg);
}

.explore-caption {
  position: absolute;
  bottom: 2px;
  background: white;
  border-radius: 15px;
  padding: 12px 18px;
  font-weight: 900;
  box-shadow: var(--shadow);
}

.exploration-content h3 {
  font-size: 23px;
  color: #2c6840;
  margin-bottom: 12px;
}

.exploration-content p {
  color: #748b7a;
  line-height: 1.8;
  font-size: 14px;
}

.explore-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 20px 0;
}

.explore-buttons button {
  background: white;
  border: 2px solid #d6ecd9;
  color: #3b8050;
  padding: 9px 14px;
  border-radius: 20px;
  font-weight: 900;
  font-size: 12px;
}

.explore-buttons button:hover,
.explore-buttons button.active {
  background: #4ca96b;
  color: white;
  border-color: #4ca96b;
}

.explore-detail {
  background: white;
  padding: 18px;
  border-radius: 16px;
  line-height: 1.8;
  font-size: 13px;
  box-shadow: var(--shadow);
}

/* ==========================
   GAME
========================== */

.game-section {
  background: #eff9ef;
}

.game-card {
  max-width: 850px;
  margin: auto;
  background: white;
  border-radius: 27px;
  padding: 30px;
  box-shadow: var(--shadow);
  text-align: center;
}

.game-header {
  margin-bottom: 25px;
}

.game-header span {
  font-size: 48px;
}

.game-header h3 {
  color: #316c45;
  margin: 8px;
  font-size: 22px;
}

.game-header p {
  color: #849788;
  font-size: 13px;
}

.game-columns {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 25px;
  text-align: left;
}

.game-columns h3 {
  margin-bottom: 13px;
  color: #397a4e;
}

.game-option {
  display: block;
  width: 100%;
  margin-bottom: 10px;
  padding: 14px;
  border-radius: 13px;
  background: #f3faf3;
  border: 2px solid #e2efe3;
  text-align: left;
  color: #46694e;
  font-weight: 800;
  transition: .2s;
}

.game-option:hover,
.game-option.selected {
  background: #e2f5e5;
  border-color: #60b67a;
}

.game-option.correct {
  background: #e3f7e8;
  border-color: #65b87d;
  color: #247443;
}

.game-option.wrong {
  background: #fff0f0;
  border-color: #df8888;
}

.game-option:disabled {
  cursor: default;
}

#gameMessage {
  margin: 20px 0 10px;
  font-weight: 900;
  color: #3c9559;
}

#gameScore {
  margin-bottom: 20px;
  color: #356d46;
}

/* ==========================
   KUIS
========================== */

.quiz-section {
  background: #fffaf0;
}

.quiz-card {
  max-width: 800px;
  margin: auto;
  background: white;
  padding: 30px;
  border-radius: 25px;
  box-shadow: var(--shadow);
}

.quiz-progress {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  color: #398d54;
  font-weight: 900;
  font-size: 13px;
  margin-bottom: 25px;
}

.progress-track {
  flex: 1;
  height: 9px;
  background: #e8f1e8;
  border-radius: 20px;
  overflow: hidden;
}

#progressBar {
  height: 100%;
  width: 0;
  background: #56b775;
  transition: .3s;
}

#question {
  font-size: 21px;
  color: #315d40;
  margin-bottom: 20px;
  line-height: 1.5;
}

.answer-option {
  display: block;
  width: 100%;
  text-align: left;
  padding: 15px;
  margin-bottom: 10px;
  background: #f7fbf7;
  border: 2px solid #e1eee2;
  border-radius: 14px;
  color: #46694e;
  font-weight: 800;
  transition: .2s;
}

.answer-option:hover:not(:disabled) {
  background: #e7f6e9;
  border-color: #7cc58c;
}

.answer-option.correct {
  background: #e3f8e8;
  border-color: #65b87d;
}

.answer-option.incorrect {
  background: #fff0f0;
  border-color: #dc8585;
}

#feedback {
  color: #408c57;
  margin: 17px 0;
  line-height: 1.7;
  font-weight: 700;
}

button:disabled {
  opacity: .55;
  cursor: not-allowed;
}

.hidden {
  display: none;
}

/* ==========================
   FAKTA MENARIK
========================== */

.fact-section {
  padding: 55px 7%;
  background: #f8fff8;
}

.fact-card {
  display: flex;
  align-items: center;
  gap: 28px;
  background: linear-gradient(110deg,#fff4cc,#fff9e7);
  padding: 32px;
  border: 2px solid white;
  border-radius: 27px;
  box-shadow: var(--shadow);
}

.fact-illustration {
  font-size: 95px;
  animation: float 4s ease-in-out infinite;
}

.fact-content > span {
  color: #c68b2b;
  font-size: 12px;
  font-weight: 900;
  letter-spacing: 2px;
}

.fact-content h2 {
  color: #745628;
  font-size: 27px;
  margin: 10px 0;
}

.fact-content p {
  color: #8a795b;
  font-size: 14px;
  line-height: 1.8;
  margin-bottom: 18px;
}

.fact-button {
  background: #e6ae43;
  color: white;
}

/* ==========================
   PROFIL
========================== */

.profile-section {
  background: #eaf8eb;
}

.profile-card {
  display: flex;
  align-items: center;
  gap: 30px;
  padding: 35px;
  background: white;
  border-radius: 28px;
  box-shadow: var(--shadow);
}

.profile-art {
  min-width: 170px;
  height: 170px;
  display: grid;
  place-items: center;
  position: relative;
  background: #e7f8e9;
  border-radius: 50%;
  font-size: 90px;
}

.profile-art span {
  position: absolute;
  right: 0;
  bottom: 10px;
  font-size: 30px;
}

.profile-content > span {
  color: #4ca96b;
  font-size: 12px;
  font-weight: 900;
  letter-spacing: 2px;
}

.profile-content h2 {
  font-size: 28px;
  color: #285e3b;
  margin: 10px 0;
}

.profile-content p {
  color: #788c7b;
  line-height: 1.8;
  font-size: 14px;
  margin-bottom: 12px;
}

.profile-content strong {
  color: #388b52;
}

/* ==========================
   FOOTER
========================== */

.footer {
  padding: 40px 15px 20px;
  text-align: center;
  color: white;
  background: #285e3b;
}

.footer-logo {
  font-size: 26px;
  font-weight: 900;
}

.footer p {
  color: #d5edda;
  margin: 10px 0 20px;
}

.footer-links {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 20px;
  margin-bottom: 25px;
}

.footer-links a {
  color: #d7f1dc;
  font-size: 13px;
  font-weight: 800;
}

.footer-links a:hover {
  color: #fff2b5;
}

.footer-bottom {
  border-top: 1px solid #ffffff30;
  padding-top: 18px;
  color: #c6e1cb;
  font-size: 12px;
}

/* ==========================
   ANIMASI
========================== */

@keyframes float {
  0%,100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-13px);
  }
}

@keyframes cloudMove {
  0%,100% {
    transform: translateX(0);
  }

  50% {
    transform: translateX(15px);
  }
}

@keyframes sunRotate {
  to {
    transform: rotate(360deg);
  }
}

/* ==========================
   RESPONSIVE TABLET
========================== */

@media(max-width:1050px) {

  nav {
    gap: 0;
  }

  nav a {
    font-size: 11px;
    padding: 9px 7px;
  }

  .features {
    grid-template-columns: repeat(2,1fr);
  }

}

/* ==========================
   RESPONSIVE HP
========================== */

@media(max-width:760px) {

  .navbar {
    padding: 12px 5%;
  }

  .logo {
    font-size: 20px;
  }

  .menu-toggle {
    display: block;
  }

  nav {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    padding: 14px;
    background: white;
    grid-template-columns: repeat(2,1fr);
    box-shadow: 0 8px 20px #285e3b20;
  }

  nav.open {
    display: grid;
  }

  nav a {
    text-align: center;
    font-size: 13px;
    padding: 12px 5px;
  }

  .hero {
    grid-template-columns: 1fr;
    text-align: center;
    padding: 55px 5%;
  }

  .hero h1 {
    font-size: 43px;
  }

  .hero-text p {
    margin: auto;
  }

  .hero-buttons,
  .hero-statistics {
    justify-content: center;
  }

  .hero-visual {
    min-height: 390px;
  }

  .earth-decoration {
    left: 3%;
    top: 0;
    font-size: 65px;
  }

  .earth-cutaway {
    width: 215px;
    height: 215px;
  }

  .cutaway-earth {
    width: 175px;
    height: 175px;
  }

  .cut-crust {
    width: 143px;
    height: 143px;
  }

  .cut-mantle {
    width: 105px;
    height: 105px;
  }

  .cut-outer {
    width: 69px;
    height: 69px;
  }

  .cut-inner {
    width: 32px;
    height: 32px;
  }

  .earth-label {
    font-size: 10px;
    padding: 7px 9px;
  }

  .mascot {
    font-size: 35px;
    bottom: -3px;
  }

  .mascot span {
    font-size: 10px;
  }

  .features {
    grid-template-columns: repeat(2,1fr);
    gap: 12px;
  }

  .feature-card {
    padding: 19px 14px;
  }

  .feature-card h3 {
    font-size: 15px;
  }

  .feature-card p {
    font-size: 12px;
  }

  .material-layout,
  .exploration-card {
    grid-template-columns: 1fr;
  }

  .material-art {
    min-height: 320px;
  }

  .exploration-card {
    padding: 22px;
  }

  .exploration-illustration {
    min-height: 250px;
  }

  .game-columns {
    grid-template-columns: 1fr;
  }

  .fact-card {
    align-items: flex-start;
    padding: 22px;
    gap: 15px;
  }

  .fact-illustration {
    font-size: 55px;
  }

  .fact-content h2 {
    font-size: 21px;
  }

  .profile-card {
    flex-direction: column;
    text-align: center;
    padding: 25px;
  }

  .profile-art {
    min-width: 130px;
    height: 130px;
    font-size: 70px;
  }

}

