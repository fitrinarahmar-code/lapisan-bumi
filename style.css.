@import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Nunito:wght@400;500;600;700;800;900&display=swap');

:root {
  --green: #347FC4;
  --dark: #225A91;
  --mint: #DDF2FF;
  --light: #EFF8FF;
  --cream: #FFF9E9;
  --text: #34536F;
  --shadow: 0 12px 35px rgba(52, 127, 196, .12);
}

body {
  font-family: 'Nunito', sans-serif;
  color: var(--text);
  background: #F8FCFF;
}

h1, h2, h3, h4 {
  font-family: 'Fredoka', sans-serif;
}
.layer-card:nth-child(1) { border-bottom: 5px solid #36a5ef; }
.layer-card:nth-child(2) { border-bottom: 5px solid #ffad48; }
.layer-card:nth-child(3) { border-bottom: 5px solid #f27669; }
.layer-card:nth-child(4) { border-bottom: 5px solid #9272ed; }

/* Nomor dan ikon tampil seperti stiker */
.layer-number, .feature-icon, .profile-avatar {
  animation: stikerGoyang 4s ease-in-out infinite;
}
.layer-card:nth-child(even) .layer-number { animation-delay: .7s; }
@keyframes stikerGoyang {
  0%, 100% { transform: rotate(0deg) translateY(0); }
  25% { transform: rotate(-4deg) translateY(-3px); }
  75% { transform: rotate(4deg) translateY(1px); }
}

/* Lapisan Bumi berdenyut pelan */
.earth-layer {
  animation: lapisanBernapas 4s ease-in-out infinite alternate;
}
.earth-layer.mantle { animation-delay: .4s; }
.earth-layer.outer-core { animation-delay: .8s; }
.earth-layer.inner-core { animation-delay: 1.2s; }
@keyframes lapisanBernapas {
  from { filter: brightness(1); }
  to { filter: brightness(1.13) saturate(1.15); }
}

/* Tombol terasa menyenangkan */
.btn, .layer-choice, .match-name, .match-answer, .answer-options button {
  transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
}
.btn:hover, .layer-choice:hover, .match-name:hover,
.match-answer:hover, .answer-options button:hover {
  transform: translateY(-3px) scale(1.015);
}

/* Kartu dan bagian halaman lebih hidup */
.feature-item:nth-child(1) .feature-icon { background: #e4f2ff; color: #287cf0; }
.feature-item:nth-child(2) .feature-icon { background: #e1fbf2; color: #159b80; }
.feature-item:nth-child(3) .feature-icon { background: #fff0df; color: #e78328; }
.feature-item:nth-child(4) .feature-icon { background: #f1eaff; color: #8061df; }
.eyebrow { color: #286dc1; background: #fff; }
.game-box, .quiz-box, .profile-box {
  border-top: 5px solid #52c8bd;
}
#gameScore {
  background: #e2fbef;
  color: #138a68;
}
#quizProgress {
  background: linear-gradient(90deg, #20bfa8, #3185f5, #9272ed);
}

/* Gerakan tetap nyaman bagi pengunjung yang mengurangi animasi */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: .01ms !important;
  }
}


/* ===== TAMPILAN MATERI LENGKAP ===== */
/* GAYA UNTUK PENJELASAN MATERI LENGKAP */
.materi-lengkap { color:#38556f; }
.materi-label { display:inline-block; padding:6px 12px; border-radius:20px; background:#e8f4ff; color:#2876cf; font-size:.72rem; font-weight:900; letter-spacing:1px; }
.materi-lengkap h3 { margin:12px 0; color:#205b91; font-size:1.35rem; }
.materi-intro { font-size:1rem; line-height:1.85; }
.materi-info-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; margin:20px 0; }
.materi-info { padding:15px; border-radius:15px; background:#f3f8ff; border:1px solid #e0edfa; }
.materi-info:nth-child(2) { background:#fff7e9; border-color:#ffebc9; }
.materi-info:nth-child(3) { background:#fff0ed; border-color:#ffddd5; }
.materi-info:nth-child(4) { background:#f2efff; border-color:#e4dcff; }
.materi-info strong { display:block; margin-bottom:5px; color:#285c8a; }
.materi-info p,.materi-subsection p,.materi-fakta p,.materi-analogi p,.materi-catatan p { margin:0; line-height:1.7; }
.materi-subsection { padding:17px 19px; margin:14px 0; background:#edfaf4; border-radius:15px; }
.materi-subsection h4 { margin:0 0 8px; color:#168263; }
.materi-subsection ul { margin:0; padding-left:21px; }
.materi-subsection li { margin:6px 0; }
.materi-fakta,.materi-analogi,.materi-catatan { padding:16px 18px; margin:12px 0; border-radius:15px; }
.materi-fakta { background:#fff7df; border-left:5px solid #f4bd43; }
.materi-analogi { background:#f2efff; border-left:5px solid #9272ed; }
.materi-catatan { background:#eaf7ff; border-left:5px solid #45a6df; }
.materi-fakta strong { color:#98620a; }
.materi-analogi strong { color:#7055c5; }
.materi-catatan strong { color:#2876a7; }
.materi-pengantar { padding:5px 0; }
.materi-pengantar h3 { color:#23679d; margin:0 0 8px; }
.materi-pengantar p { margin:0; line-height:1.8; }
@media(max-width:600px) {
  .materi-info-grid { grid-template-columns:1fr; }
  .materi-lengkap h3 { font-size:1.15rem; }
}

/* Sinkronisasi menu HP dan tombol kembali ke atas dengan script.js */
@media(max-width:640px) {
  .navbar nav.open { display:flex; }
  .navbar nav.show { display:flex; }
}
.back-top { opacity:0; pointer-events:none; transform:translateY(10px); transition:.25s; }
.back-top.show { opacity:1; pointer-events:auto; transform:translateY(0); }
